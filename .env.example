# Runtime configuration
HOST=0.0.0.0
PORT=15000
DEBUG=False

# Optional API token. If set, hardware-changing APIs require X-API-Token.
SAT_YUNTAI_API_TOKEN=
SAT_YUNTAI_CORS_ORIGINS=

# TLE cache
SAT_YUNTAI_TLE_CACHE_DIR=tle
TLE_UPDATE_INTERVAL=1

# Tracking thresholds
MIN_VISIBLE_ELEVATION=5
MIN_PASS_MAX_ELEVATION=30
TRACKING_STOP_ELEVATION=20

# Tracking control cadence and command deadband
TRACKING_UPDATE_INTERVAL=0.02
GIMBAL_COMMAND_DEADBAND_DEGREES=0.05
GIMBAL_TRACKING_SPEED=10
GIMBAL_TRACKING_ACCELERATION=0

# X2 / X2-3 ephemeris sources
TLE_URL_X2=https://celestrak.org/NORAD/elements/gp.php?INTDES=2025-067&FORMAT=tle
TLE_URL_X2__3=https://celestrak.org/NORAD/elements/gp.php?INTDES=2026-091&FORMAT=tle
X2_SATELLITES=HJS-6A,HJS-6B,HJS-6C,HJS-6D
X2_3_SATELLITES=2026-091A,2026-091B,2026-091C,2026-091D
SATELLITE_ALIASES_X2=2025-067B:04-YH,2025-067C:01-YH,2025-067D:02-CG
SATELLITE_ALIASES_X2__3=2026-091A:11-YH,2026-091B:18-GD,2026-091C:09-CG,2026-091D:10-BY
